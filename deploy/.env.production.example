# Budglee - bai mau config cho VPS.
# COPY file nay thanh deploy/.env.production roi dien gia tri THAT.
# KHONG commit .env.production (no da nam trong .gitignore).

# --- Database ---
DB_NAME=budglee_db
DB_USER=budglee_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- JWT (bat buoc) ---
# Sinh khoa:  openssl rand -base64 48
# Thieu gia tri nay backend khong khoi dong (application.yml khong con secret mac dinh).
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Khóa mã hóa API key chatbot tại database (sinh riêng bằng: openssl rand -base64 48).
# Giữ ổn định qua các lần deploy; thay khóa sẽ khiến key đã lưu không giải mã được.
CHATBOT_KEY_ENCRYPTION_SECRET=

# --- Tai khoan quan tri he thong ---
# Credential demo dùng chung cho nhóm; đổi nếu đây là môi trường thật.
APP_SECURITY_SYSTEM_ADMIN_EMAIL=admin@budglee.local
APP_SECURITY_SYSTEM_ADMIN_PASSWORD=BudgleeAdmin@2026!

# --- SMTP (bat buoc neu can gui email OTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
