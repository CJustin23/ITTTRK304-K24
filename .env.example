# =================================================================
# BUDGLEE PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and adjust variables to your local machine
# =================================================================

# --- Application Profile ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (MySQL 8.0) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=budglee_db
DB_USER=budglee_user
DB_PASSWORD=budglee_secret
DB_ROOT_PASSWORD=root_secret

# --- Redis Caching & Session ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Security (Spring Security) ---
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_change_in_production
JWT_EXPIRATION_MS=86400000

# --- Frontend Application ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
PORT=3000

# --- Nginx & VPS Deployment ---
DOMAIN_NAME=budglee.local
SSL_EMAIL=admin@budglee.local

APP_SECURITY_SYSTEM_ADMIN_EMAIL=admin@budglee.local
APP_SECURITY_SYSTEM_ADMIN_PASSWORD=
